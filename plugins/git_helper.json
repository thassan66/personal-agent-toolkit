{
  "name": "git-helper",
  "description": "Small git convenience plugin for personal local workflows",
  "commands": [
    {
      "name": "git-status",
      "description": "Run git status --short --branch",
      "action": {
        "type": "shell",
        "command": "git status --short --branch",
        "timeout": 20
      }
    }
  ],
  "tools": [
    {
      "name": "git_status_tool",
